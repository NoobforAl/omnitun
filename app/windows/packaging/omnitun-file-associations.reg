Windows Registry Editor Version 5.00

; Lets Windows offer Omnitun for VPN config files and share links, for the current user only.
; Edit the path to omnitun.exe below (use \\ for each backslash), then double-click this file.
; Files are added to "Open with" (the default program is not changed); links are claimed.

[HKEY_CURRENT_USER\Software\Classes\Omnitun.Config]
@="Omnitun configuration"

[HKEY_CURRENT_USER\Software\Classes\Omnitun.Config\shell\open\command]
@="\"C:\\Program Files\\Omnitun\\omnitun.exe\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\.ovpn\OpenWithProgids]
"Omnitun.Config"=hex(0):

[HKEY_CURRENT_USER\Software\Classes\.conf\OpenWithProgids]
"Omnitun.Config"=hex(0):

[HKEY_CURRENT_USER\Software\Classes\.json\OpenWithProgids]
"Omnitun.Config"=hex(0):

[HKEY_CURRENT_USER\Software\Classes\.yaml\OpenWithProgids]
"Omnitun.Config"=hex(0):

[HKEY_CURRENT_USER\Software\Classes\.yml\OpenWithProgids]
"Omnitun.Config"=hex(0):

[HKEY_CURRENT_USER\Software\Classes\.txt\OpenWithProgids]
"Omnitun.Config"=hex(0):

[HKEY_CURRENT_USER\Software\Classes\vless]
@="URL:vless link"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\vless\shell\open\command]
@="\"C:\\Program Files\\Omnitun\\omnitun.exe\" \"%1\""

